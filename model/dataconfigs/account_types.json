        "GET /login",
        "POST /api/authenticate",
        "POST /login",
        "GET /logout",
        "DELETE /api/authenticate",
        "GET /api/microblog",
        "POST /api/microblog",
        "PUT /api/microblog",
        "DELETE /api/microblog",
        "POST /api/microblog/reply",
        "POST /api/microblog/reaction",
